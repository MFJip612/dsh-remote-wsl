{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "newLine": "lf"
  },
  "include": ["src/index.ts", "src/config.ts", "src/contracts.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
