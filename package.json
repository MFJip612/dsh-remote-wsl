{
  "id": "dsh-remote-wsl",
  "name": "dsh-remote-wsl",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Connect WSL projects to DeepSeek Harness with Linux tools, terminals and native file deliveries.",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24.9.0"
  },
  "repository": "https://github.com/MFJip612/dsh-remote-wsl",
  "author": {
    "name": "MFJip612",
    "github": "MFJip612",
    "avatar": "https://avatars.githubusercontent.com/u/103869422?v=4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "node scripts/build.ts --check && node --test test/build.test.ts && node test/client.test.ts && node test/pure.test.ts && node test/run.ts && node test/tools.test.ts && node test/registration.test.ts",
    "test:all": "npm test",
    "check": "node scripts/build.ts --check",
    "prepare": "node scripts/build.ts",
    "prepack": "node scripts/build.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "category": "tool",
  "status": "unverified",
  "declaredCompatibility": "not stated",
