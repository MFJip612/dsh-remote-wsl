    "index.js",
    "client.js",
    "lib/*.js",
    "scripts/repair-legacy.cjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client && npm run build:cjs",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "npm run build && node test/pure.test.js && node test/run.js && node test/tools.test.js && node test/registration.test.js",
    "test:all": "npm test",
    "check": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
