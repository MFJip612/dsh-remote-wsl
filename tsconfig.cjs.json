{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src/scripts",
    "outDir": "dist/scripts",
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "newLine": "lf"
  },
  "include": ["src/scripts/**/*.cts"]
}
